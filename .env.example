# Copy to .env for local Postgres (see docker-compose.yml). Unset, the app and
# tests fall back to a local SQLite file — no Docker needed.
DATABASE_URL=postgresql+psycopg://marketplace:marketplace@localhost:5432/marketplace

# Connection pool (Postgres only; SQLite ignores these). Defaults: 10 kept
# open + 30 overflow = 40, matching Starlette's 40-token threadpool. A request
# that waits longer than DB_POOL_TIMEOUT_SECONDS for a connection gets a 503
# with Retry-After rather than queueing. replicas x (size + overflow) must fit
# Postgres's max_connections with headroom. DB_POOL=null opens a connection per
# checkout and leaves pooling to an external pooler (PgBouncer etc.).
# DB_POOL=queue
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=30
# DB_POOL_TIMEOUT_SECONDS=5

# fork divergence: browse marketplace with human sellers — see browse-core spec
QUOTE_TTL_MINUTES=15
OFFER_TTL_MINUTES=120

# Payments — leave unset to use the built-in deterministic fake provider.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# CURRENCY=usd
# PAYMENT_TTL_MINUTES=30
# ONBOARDING_RETURN_URL=https://your-app.example/onboarded

# Auth — sessions are DB-backed; the admin account is seeded at startup, and a
# changed ADMIN_PASSWORD is rotated in on the next restart (existing admin
# sessions are revoked).
# ADMIN_EMAIL=ops@your-app.example
# ADMIN_PASSWORD=change-me
# SESSION_TTL_HOURS=72
# COOKIE_SECURE=false
# set true behind TLS in production — gates the Secure flag on the page-auth
# session cookie (pages.py's /signup, /login); false is correct for local
# HTTP dev only.
# BASE_URL is your app's own frontend, not this API: verification/reset links
# are BASE_URL/verify?token=... and BASE_URL/password-reset/confirm?token=...,
# and the API has no GET handlers for those paths — whatever serves BASE_URL
# must relay the token to the POST endpoints.
# BASE_URL=https://your-app.example

# Notifications - outbox drained in-process; SMTP unset -> console adapter (logs).
# NOTIFY_DRAIN_SECONDS=5
# NOTIFY_MAX_ATTEMPTS=5
# SWEEP_INTERVAL_SECONDS=60
# The maintenance loop (outbox drain + sweeps) runs in every app process unless
# disabled; with several replicas, set false on all but one instance.
# MAINTENANCE_ENABLED=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# MAIL_FROM=noreply@your-app.example

# Disputes
# DISPUTE_WINDOW_DAYS=7
# CHARGEBACK_FEE_USD=15.00

# Observability & ops - LOG_FORMAT=plain for a one-line human format locally;
# JSON is the default (and what production should keep).
# LOG_FORMAT=json

# Retention (days): swept tables stay bounded on the maintenance loop's own
# clock. PENDING notifications are never reaped regardless of age.
# RETENTION_IDEMPOTENCY_DAYS=7
# RETENTION_WEBHOOKS_DAYS=30
# RETENTION_NOTIFICATIONS_DAYS=30

# API hardening - TRUSTED_HOSTS/CORS_ORIGINS are JSON arrays, not bare
# comma-separated strings (pydantic-settings list fields); open by default
# for dev, narrow both before production:
# TRUSTED_HOSTS=["api.example.com"]
# CORS_ORIGINS=["https://app.example.com"]
# MAX_BODY_BYTES=1048576
